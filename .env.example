# Create your bot with @BotFather. Never commit a real token or session.
BOT_TOKEN=
ADMIN_USER_ID=
# python -m sniper setup generates these locally without printing them.
APP_KEY=
WEBHOOK_SECRET=
# Local default. On free ephemeral hosting use an external PostgreSQL database.
DATABASE_URL=sqlite+aiosqlite:///./assistant.db
# polling for always-running workers; webhook is optional.
BOT_TRANSPORT=polling
PUBLIC_BASE_URL=
# Full HTTPS public URL enables Accounts -> Add account (QR + 2FA Mini App).
# Read by python main.py. Use a persistent directory such as /data/cryptobot-state.
DATA_DIR=
MAX_ACCOUNTS=3
PORT=8000
# off = pasted cards; passive = incoming messages; userbot = navigate/refresh first page.
MONITOR_SOURCE=off
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
USER_SESSION_ENCRYPTED=
USER_SESSION_FILE=.secrets/session.enc
# Enable execution only when the owner intends to use the auto mode.
# Selecting a mode does not arm it: the owner confirms it separately in the bot.
LIVE_TRADING_ENABLED=false
# Minimum is 3 seconds; Telegram FloodWait always overrides this interval.
REFRESH_SECONDS=1
ACTION_INTERVAL=0.2


# Optional PC HTTPS helper; omit on public HTTPS hosting.
# PUBLIC_BASE_URL_FILE=data/public-url.txt
